# Copy to `.env` and adjust for your environment.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kuytu?schema=public"

# MVP only — the demo user the API treats as "the current user" until real
# authentication is wired up. Optional; falls back to the seeded demo account.
# DEMO_USER_EMAIL="demo@kuytu.app"

# Uploadthing — real image uploads for the profile Photo Manager.
# Create an app at https://uploadthing.com and copy the API key ("token").
# v7 uses a single token; the legacy secret/appId pair is also accepted.
UPLOADTHING_TOKEN="<your-uploadthing-token>"
# Legacy (v6-style) alternative:
# UPLOADTHING_SECRET="<your-uploadthing-secret>"
# UPLOADTHING_APP_ID="<your-uploadthing-app-id>"
